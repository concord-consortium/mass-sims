{
  "name": "bananas",
  "version": "0.1.1",
  "private": true,
  "description": "An interactive genetics simulation.",
  "massSims": {
    "title": "Bananas",
    "gradeBand": "Grades 6-8",
    "order": 1,
    "titleFont": {
      "family": "Slackey",
      "letterSpacing": "0.32px"
    },
    "colors": {
      "surface": "#fffdf2",
      "text": "#5c4813",
      "border": "#9e8540",
      "hover": "#fff3c4",
      "active": "#ffe680",
      "selectedText": "#fff3c4"
    }
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "tsx ../../scripts/generate-index-top.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf --glob dist '*.tsbuildinfo'"
  },
  "dependencies": {
    "@concord-consortium/mass-sims-shared": "0.1.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^25.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.0"
  }
}
